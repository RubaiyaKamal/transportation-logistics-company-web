# ---------------------------------------------------------------------------
# Public site URL (used for canonical URLs, hreflang, sitemap, OG images)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.scaldis-logistics.be

# ---------------------------------------------------------------------------
# Quote / contact form email delivery
# Choose ONE provider. If both are set, Resend takes precedence.
# ---------------------------------------------------------------------------
# Resend (https://resend.com)
RESEND_API_KEY=
MAIL_FROM="Scaldis Logistics <info@scaldis-logistics.be>"
MAIL_TO="info@scaldis-logistics.be"

# SMTP fallback (used when RESEND_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Optional lead storage. When set, quote submissions are also stored in MongoDB.
# ---------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB=scaldis_logistics

# ---------------------------------------------------------------------------
# Analytics (loaded only after cookie consent)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Google Maps embed (contact page; loaded on click)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_PLACE=Noorderlaan%20125%2C%202030%20Antwerpen
